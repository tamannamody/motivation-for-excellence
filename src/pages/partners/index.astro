---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { partners, areas, areaOrder, stats, coFunders } from '../../lib/site';
import { img } from '../../lib/images';

const places = ['Pan-India', ...stats.stateList];
---

<Base
  title="Our partners"
  description={`Meet the ${stats.partners} NGOs and institutions MFE partners with across healthcare, education, livelihoods and nurturing excellence in India.`}
  image={img('site/hero-circle.webp')}
>
  <PageHero
    eyebrow="Partner directory"
    title={`${stats.partners} organisations. One shared standard.`}
    lead="Our partners know their communities better than anyone. Browse by area of work or by state, or search for an organisation by name."
    crumbs={[{ href: '/partners/', label: 'Partners' }]}
  />

  <section class="section--tight dir">
    <div class="wrap">
      <form class="filters" role="search" aria-label="Filter partners" onsubmit="return false">
        <div class="seg" role="group" aria-label="Area of work">
          <button type="button" data-area="" aria-pressed="true">All</button>
          {
            areaOrder.map((a) => (
              <button type="button" data-area={a} aria-pressed="false">
                {areas[a].short}
              </button>
            ))
          }
        </div>
        <div class="fields">
          <label class="field">
            <span class="sr-only">State</span>
            <select name="state">
              <option value="">All states</option>
              {places.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label class="field search">
            <span class="sr-only">Search partners by name</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" name="q" placeholder="Search by name" autocomplete="off" />
          </label>
        </div>
      </form>

      <h2 class="sr-only">All partners</h2>
      <p class="count" aria-live="polite"><strong data-count>{partners.length}</strong> partners</p>

      <div class="grid" data-grid>
        {partners.map((p) => <PartnerCard partner={p} showSummary />)}
      </div>
      <p class="empty" hidden data-empty>No partners match those filters. <button type="button" data-reset>Clear filters</button></p>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap cofund" id="cofund">
      <div>
        <span class="eyebrow">Philanthropy partners</span>
        <h2>We co-fund with others who share the goal.</h2>
      </div>
      <ul>
        {
          coFunders.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLAnchorElement>('.card')];
  const areaBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-area]')];
  const state = document.querySelector<HTMLSelectElement>('select[name=state]')!;
  const q = document.querySelector<HTMLInputElement>('input[name=q]')!;
  const count = document.querySelector('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  let area = params.get('area') ?? '';
  state.value = params.get('state') ?? '';
  q.value = params.get('q') ?? '';

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok =
        (!area || c.dataset.areas!.split(' ').includes(area)) &&
        (!state.value || c.dataset.states!.split('|').includes(state.value)) &&
        (!term || c.dataset.name!.includes(term));
      c.hidden = !ok;
      if (ok) shown++;
    }
    areaBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === area)));
    count.textContent = String(shown);
    empty.hidden = shown > 0;
    const p = new URLSearchParams();
    if (area) p.set('area', area);
    if (state.value) p.set('state', state.value);
    if (term) p.set('q', term);
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
  }

  areaBtns.forEach((b) =>
    b.addEventListener('click', () => {
      area = b.dataset.area ?? '';
      apply();
    }),
  );
  state.addEventListener('change', apply);
  q.addEventListener('input', apply);
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    area = '';
    state.value = '';
    q.value = '';
    apply();
  });
  apply();
</script>

<style>
  .dir {
    padding-top: 0;
  }
  .filters {
    position: sticky;
    top: calc(var(--header-h) + 8px);
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
  }
  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .seg button {
    border: 0;
    background: transparent;
    padding: 10px 16px;
    border-radius: 999px;
    font: inherit;
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--ink);
    cursor: pointer;
    min-height: 44px;
  }
  .seg button:hover {
    background: var(--paper);
  }
  .seg button[aria-pressed='true'] {
    background: var(--navy);
    color: var(--white);
  }
  .fields {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .field select,
  .field input {
    font: inherit;
    font-size: 0.95rem;
    min-height: 44px;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 999px;
    padding: 0 16px;
    color: var(--ink);
  }
  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search svg {
    position: absolute;
    left: 14px;
    color: var(--muted);
  }
  .search input {
    padding-left: 40px;
    width: 220px;
  }
  .count {
    margin: 28px 0 18px;
    color: var(--muted);
  }
  .count strong {
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 20px;
  }
  .grid :global(.card[hidden]) {
    display: none;
  }
  .empty {
    padding: 48px 0;
    text-align: center;
    color: var(--muted);
  }
  .empty button {
    font: inherit;
    color: var(--navy);
    font-weight: 600;
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .cofund {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(28px, 5vw, 72px);
    padding: clamp(32px, 5vw, 56px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--teal-50);
  }
  .cofund h2 {
    font-size: var(--step-3);
    margin-top: 14px;
  }
  .cofund ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .cofund li {
    padding-bottom: 20px;
    border-bottom: 1px solid rgb(28 60 140 / 0.15);
  }
  .cofund h3 {
    font-size: var(--step-2);
    color: var(--navy);
    margin-bottom: 6px;
  }
  .cofund p {
    color: #2a3550;
  }
  @media (max-width: 860px) {
    .filters {
      border-radius: var(--radius);
      position: static;
    }
    .fields,
    .field,
    .search input,
    .field select {
      width: 100%;
    }
    .cofund {
      grid-template-columns: 1fr;
    }
  }
</style>
