---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { partners, areas, areaOrder, stats, coFunders } from '../../lib/site';
import { img } from '../../lib/images';

const places = ['Pan-India', ...stats.stateList];

// Hero network: real partner photos around a central hub
const nodes = [
  { src: 'partners/karuna-trust/3.webp', x: 14, y: 20, size: 116 },
  { src: 'partners/quest/1.webp', x: 54, y: 6, size: 92 },
  { src: 'partners/bridges-of-sports/5.webp', x: 89, y: 24, size: 124 },
  { src: 'partners/wotr/1.webp', x: 90, y: 74, size: 100 },
  { src: 'partners/chetana-vikas/1.webp', x: 54, y: 93, size: 112 },
  { src: 'partners/educate-girls/2.webp', x: 11, y: 76, size: 98 },
];
---

<Base
  title="Our partners"
  description={`Meet the ${stats.partners} NGOs and institutions MFE partners with across healthcare, education, livelihoods and nurturing excellence in India.`}
  image={img('site/hero-circle.webp')}
>
  <div class="phero bgfx bgfx--teal">
    <PageHero
      eyebrow="Partner directory"
      title={`${stats.partners} organisations. One shared standard.`}
      lead="Our partners know their communities better than anyone. Browse by area of work or by state, or search for an organisation by name."
      crumbs={[{ href: '/partners/', label: 'Partners' }]}
    />
    <div class="net" aria-hidden="true">
      <svg class="net-lines" viewBox="0 0 100 100" preserveAspectRatio="none">
        {nodes.map((n) => <line x1="50" y1="50" x2={n.x} y2={n.y} />)}
        {nodes.map((n, i) => {
          const m = nodes[(i + 1) % nodes.length];
          return <line class="ring" x1={n.x} y1={n.y} x2={m.x} y2={m.y} />;
        })}
      </svg>
      <div class="hub">
        <strong>{stats.partners}</strong>
        <span>partners</span>
      </div>
      {
        nodes.map((n, i) => (
          <span class="node" style={`--x:${n.x}%;--y:${n.y}%;--s:${n.size}px;--d:${i * -1.3}s`}>
            <Image src={img(n.src)} alt="" widths={[160, 260]} sizes={`${n.size}px`} loading="eager" />
          </span>
        ))
      }
    </div>
  </div>

  <section class="section--tight dir">
    <div class="wrap">
      <form class="filters" role="search" aria-label="Filter partners" onsubmit="return false">
        <div class="seg" role="group" aria-label="Area of work">
          <button type="button" data-area="" aria-pressed="true">All</button>
          {
            areaOrder.map((a) => (
              <button type="button" data-area={a} aria-pressed="false">
                {areas[a].short}
              </button>
            ))
          }
        </div>
        <div class="fields">
          <label class="field">
            <span class="sr-only">State</span>
            <select name="state">
              <option value="">All states</option>
              {places.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <label class="field search">
            <span class="sr-only">Search partners by name</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input type="search" name="q" placeholder="Search by name" autocomplete="off" />
          </label>
        </div>
      </form>

      <h2 class="sr-only">All partners</h2>
      <p class="count" aria-live="polite"><strong data-count>{partners.length}</strong> partners</p>

      <div class="grid" data-grid>
        {partners.map((p) => <PartnerCard partner={p} showSummary />)}
      </div>
      <p class="empty" hidden data-empty>No partners match those filters. <button type="button" data-reset>Clear filters</button></p>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap cofund" id="cofund">
      <div>
        <span class="eyebrow">Philanthropy partners</span>
        <h2>We co-fund with others who share the goal.</h2>
      </div>
      <ul>
        {
          coFunders.map((c) => (
            <li>
              <h3>{c.name}</h3>
              <p>{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const grid = document.querySelector<HTMLElement>('[data-grid]')!;
  const cards = [...grid.querySelectorAll<HTMLAnchorElement>('.card')];
  const areaBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-area]')];
  const state = document.querySelector<HTMLSelectElement>('select[name=state]')!;
  const q = document.querySelector<HTMLInputElement>('input[name=q]')!;
  const count = document.querySelector('[data-count]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;

  const params = new URLSearchParams(location.search);
  let area = params.get('area') ?? '';
  state.value = params.get('state') ?? '';
  q.value = params.get('q') ?? '';

  function apply() {
    const term = q.value.trim().toLowerCase();
    let shown = 0;
    for (const c of cards) {
      const ok =
        (!area || c.dataset.areas!.split(' ').includes(area)) &&
        (!state.value || c.dataset.states!.split('|').includes(state.value)) &&
        (!term || c.dataset.name!.includes(term));
      c.hidden = !ok;
      if (ok) shown++;
    }
    areaBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.area === area)));
    count.textContent = String(shown);
    empty.hidden = shown > 0;
    const p = new URLSearchParams();
    if (area) p.set('area', area);
    if (state.value) p.set('state', state.value);
    if (term) p.set('q', term);
    history.replaceState(null, '', p.size ? `?${p}` : location.pathname);
  }

  areaBtns.forEach((b) =>
    b.addEventListener('click', () => {
      area = b.dataset.area ?? '';
      apply();
    }),
  );
  state.addEventListener('change', apply);
  q.addEventListener('input', apply);
  document.querySelector('[data-reset]')?.addEventListener('click', () => {
    area = '';
    state.value = '';
    q.value = '';
    apply();
  });
  apply();
</script>

<style>
  /* Hero: partner network on the right */
  .phero {
    position: relative;
  }
  .phero :global(.text) {
    max-width: 680px;
  }
  .phero :global(h1) {
    font-size: clamp(2.9rem, 1.6rem + 3.9vw, 5.1rem);
  }
  .net {
    position: absolute;
    top: 50%;
    right: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    width: min(38vw, 500px);
    aspect-ratio: 560 / 500;
    transform: translateY(-46%);
    pointer-events: none;
  }
  .net-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .net-lines line {
    stroke: rgb(28 60 140 / 0.28);
    stroke-width: 1.5;
    stroke-dasharray: 4 6;
    vector-effect: non-scaling-stroke;
    animation: net-flow 12s linear infinite;
  }
  .net-lines line.ring {
    stroke: rgb(66 192 182 / 0.45);
    stroke-dasharray: none;
    animation: none;
  }
  @keyframes net-flow {
    to { stroke-dashoffset: -100; }
  }
  .hub {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 138px;
    height: 138px;
    transform: translate(-50%, -50%);
    display: grid;
    place-content: center;
    text-align: center;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--navy-900), var(--navy));
    color: var(--white);
    box-shadow: 0 0 0 10px rgb(66 192 182 / 0.18), 0 0 0 22px rgb(66 192 182 / 0.08), 0 24px 48px -20px rgb(8 21 58 / 0.7);
  }
  .hub strong {
    font-family: var(--font-display);
    font-size: 2.8rem;
    line-height: 1;
    color: var(--teal-300);
  }
  .hub span {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #d5dcf0;
  }
  .node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    margin: calc(var(--s) / -2) 0 0 calc(var(--s) / -2);
    border-radius: 50%;
    overflow: hidden;
    border: 4px solid var(--white);
    box-shadow: 0 16px 34px -14px rgb(8 21 58 / 0.55);
    animation: node-float 7s ease-in-out infinite;
    animation-delay: var(--d);
  }
  .node :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  @keyframes node-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (max-width: 1100px) {
    .net { display: none; }
    .phero :global(.text) { max-width: 820px; }
  }

  .dir {
    padding-top: 0;
  }
  .filters {
    position: sticky;
    top: calc(var(--header-h) + 8px);
    z-index: 10;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding: 10px;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--shadow);
  }
  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .seg button {
    border: 0;
    background: transparent;
    padding: 10px 16px;
    border-radius: 999px;
    font: inherit;
    font-weight: 550;
    font-size: 0.95rem;
    color: var(--ink);
    cursor: pointer;
    min-height: 44px;
  }
  .seg button:hover {
    background: var(--paper);
  }
  .seg button[aria-pressed='true'] {
    background: var(--navy);
    color: var(--white);
  }
  .fields {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .field select,
  .field input {
    font: inherit;
    font-size: 0.95rem;
    min-height: 44px;
    border: 1px solid var(--line);
    background: var(--paper);
    border-radius: 999px;
    padding: 0 16px;
    color: var(--ink);
  }
  .search {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search svg {
    position: absolute;
    left: 14px;
    color: var(--muted);
  }
  .search input {
    padding-left: 40px;
    width: 220px;
  }
  .count {
    margin: 28px 0 18px;
    color: var(--muted);
  }
  .count strong {
    color: var(--ink);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 20px;
  }
  .grid :global(.card[hidden]) {
    display: none;
  }
  .empty {
    padding: 48px 0;
    text-align: center;
    color: var(--muted);
  }
  .empty button {
    font: inherit;
    color: var(--navy);
    font-weight: 600;
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }
  .cofund {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: clamp(28px, 5vw, 72px);
    padding: clamp(32px, 5vw, 56px);
    border-radius: calc(var(--radius) + 8px);
    background: var(--teal-50);
  }
  .cofund h2 {
    font-size: var(--step-3);
    margin-top: 14px;
  }
  .cofund ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 20px;
  }
  .cofund li {
    padding-bottom: 20px;
    border-bottom: 1px solid rgb(28 60 140 / 0.15);
  }
  .cofund h3 {
    font-size: var(--step-2);
    color: var(--navy);
    margin-bottom: 6px;
  }
  .cofund p {
    color: #2a3550;
  }
  @media (max-width: 860px) {
    .filters {
      border-radius: var(--radius);
      position: static;
    }
    .fields,
    .field,
    .search input,
    .field select {
      width: 100%;
    }
    .cofund {
      grid-template-columns: 1fr;
    }
  }
</style>
