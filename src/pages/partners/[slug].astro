---
import { link } from '../../lib/url';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PartnerCard from '../../components/PartnerCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { partners, areas, where, summary, site, type Partner } from '../../lib/site';
import { img } from '../../lib/images';

export function getStaticPaths() {
  return partners.map((p, i) => ({
    params: { slug: p.slug },
    props: { p, prev: partners[(i - 1 + partners.length) % partners.length], next: partners[(i + 1) % partners.length] },
  }));
}

interface Props {
  p: Partner;
  prev: Partner;
  next: Partner;
}
const { p, prev, next } = Astro.props;
const place = where(p);
const lead = p.images[0] ? img(p.images[0]) : img('site/hero-circle.webp');
const gallery = p.images.slice(1);
const related = partners.filter((o) => o.slug !== p.slug && o.areas.some((a) => p.areas.includes(a))).slice(0, 3);
const reading = p.links.filter((l) => l !== p.website && /^https?:/.test(l) && !/fbclid/.test(l)).slice(0, 4);
const host = (u: string) => new URL(u).hostname.replace(/^www\./, '');
const desc = summary(p, 155) || `${p.name}, an MFE partner in ${areas[p.areas[0]].title.toLowerCase()}.`;

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site.url + '/' },
    { '@type': 'ListItem', position: 2, name: 'Partners', item: site.url + '/partners/' },
    { '@type': 'ListItem', position: 3, name: p.name, item: `${site.url}/partners/${p.slug}/` },
  ],
};
---

<Base title={p.name} description={desc} image={lead} schema={[breadcrumb]}>
  <section class="top">
    <div class="wrap top-grid">
      <div class="intro">
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href={link('/')}>Home</a></li>
            <li><a href={link('/partners/')}>Partners</a></li>
            <li aria-current="page">{p.name}</li>
          </ol>
        </nav>
        <div class="tags">
          {p.areas.map((a) => <a class="chip" href={link(`/what-we-fund/${a}/`)}>{areas[a].title}</a>)}
        </div>
        <h1>{p.name}</h1>
        {p.projectTitle && <p class="project-title">{p.projectTitle}</p>}
        <dl class="facts">
          {place && <div><dt>Where</dt><dd>{place}</dd></div>}
          {p.since && <div><dt>Supported by MFE since</dt><dd>{p.since}</dd></div>}
          <div><dt>Area of work</dt><dd>{p.areas.map((a) => areas[a].title).join(', ')}</dd></div>
        </dl>
        {
          p.website && (
            <a class="btn btn--ghost" href={p.website} rel="noopener" target="_blank">
              Visit {host(p.website)} <Arrow />
            </a>
          )
        }
      </div>
      <div class="lead-pic">
        <Image src={lead} alt={`${p.name} programme photo`} widths={[480, 720, 1000]} sizes="(max-width: 900px) 100vw, 46vw" loading="eager" fetchpriority="high" />
        <div class="stripes deco" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <section class="section--tight">
    <div class="wrap body">
      <article class="content">
        {
          p.project.length > 0 && (
            <div class="supports">
              <span class="eyebrow">What MFE supports</span>
              {p.projectTitle && <h2>{p.projectTitle}</h2>}
              <div class="prose">
                {p.project.map((t) => <p>{t}</p>)}
              </div>
            </div>
          )
        }

        {
          p.about.length > 0 && (
            <div class="about">
              <h2>About {p.name}</h2>
              <div class="prose">
                {p.about.map((t) => <p>{t}</p>)}
              </div>
            </div>
          )
        }

        {
          p.nurturing && (
            <div class="about">
              <h2>Nurturing excellence</h2>
              <div class="prose">
                {p.nurturing.map((t) => <p>{t}</p>)}
              </div>
            </div>
          )
        }

        {
          p.about.length === 0 && p.project.length === 0 && (
            <p class="lead">A fuller profile of our work with {p.name} is coming soon.</p>
          )
        }

        {
          reading.length > 0 && (
            <div class="reading">
              <h2>Further reading</h2>
              <ul>
                {reading.map((l) => (
                  <li>
                    <a href={l} rel="noopener" target="_blank">
                      {host(l)} <Arrow size={14} />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </article>

      {
        gallery.length > 0 && (
          <aside class="gallery" aria-label="Photos">
            {gallery.map((g) => (
              <Image src={img(g)} alt={`${p.name} programme photo`} widths={[360, 560]} sizes="(max-width: 900px) 50vw, 340px" loading="lazy" />
            ))}
          </aside>
        )
      }
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section--tight related">
        <div class="wrap">
          <h2 class="rel-h">More in {areas[p.areas[0]].title.toLowerCase()}</h2>
          <div class="rel-grid">
            {related.map((r) => (
              <PartnerCard partner={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <nav class="wrap pager" aria-label="Partner navigation">
    <a href={link(`/partners/${prev.slug}/`)} class="prev"><small>Previous</small><span>{prev.name}</span></a>
    <a href={link(`/partners/${next.slug}/`)} class="next"><small>Next</small><span>{next.name}</span></a>
  </nav>

  <CtaBand />
</Base>

<style>
  .top {
    padding-block: clamp(32px, 5vw, 64px) clamp(24px, 4vw, 48px);
  }
  .top-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .intro {
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: #b8b3a6;
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tags .chip {
    text-decoration: none;
  }
  h1 {
    font-size: var(--step-5);
  }
  .project-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--navy);
    line-height: 1.2;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    margin: 8px 0;
    padding: 20px 0;
    border-block: 1px solid var(--line);
    width: 100%;
  }
  .facts dt {
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .facts dd {
    margin: 4px 0 0;
    font-weight: 550;
  }
  .lead-pic {
    position: relative;
  }
  .lead-pic :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .deco {
    position: absolute;
    left: -18px;
    bottom: -18px;
    width: 40%;
    height: 40%;
    border-radius: var(--radius);
    opacity: 0.5;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }
  .content {
    display: grid;
    gap: 48px;
  }
  .supports {
    display: grid;
    gap: 16px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius);
    background: var(--white);
    border-left: 6px solid var(--teal);
  }
  .supports h2,
  .about h2,
  .reading h2 {
    font-size: var(--step-3);
  }
  .about {
    display: grid;
    gap: 16px;
  }
  .reading ul {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .reading a {
    display: inline-flex;
    gap: 6px;
    align-items: center;
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--white);
    border: 1px solid var(--line);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.93rem;
  }
  .gallery {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .gallery :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .gallery :global(img:first-child) {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 3;
  }
  .related {
    border-top: 1px solid var(--line);
  }
  .rel-h {
    font-size: var(--step-3);
    margin-bottom: 24px;
  }
  .rel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-block: 24px;
  }
  .pager a {
    display: grid;
    gap: 4px;
    padding: 22px 26px;
    border-radius: var(--radius);
    background: var(--white);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .pager a:hover {
    background: var(--navy);
    color: var(--white);
  }
  .pager small {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .pager a:hover small {
    color: var(--teal-300);
  }
  .pager span {
    font-family: var(--font-display);
    font-size: var(--step-1);
  }
  .next {
    text-align: right;
  }
  @media (max-width: 900px) {
    .top-grid,
    .body {
      grid-template-columns: 1fr;
    }
    .lead-pic {
      order: -1;
    }
    .gallery {
      position: static;
      grid-template-columns: 1fr 1fr;
    }
    .rel-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .next {
      text-align: left;
    }
  }
</style>
