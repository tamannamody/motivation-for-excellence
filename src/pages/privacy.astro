---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../lib/site';
---

<Base title="Privacy notice" description="How Motivation for Excellence (MFE) handles the personal information you share with us.">
  <PageHero eyebrow="Privacy" title="Privacy notice" lead="Plain language, kept short." crumbs={[{ href: '/privacy/', label: 'Privacy' }]} />
  <section class="section--tight">
    <div class="narrow prose body">
      <h2>What we collect</h2>
      <p>
        This website does not use advertising cookies or tracking pixels. If you write to us, we receive what you choose to send:
        usually your name, email address, organisation and message.
      </p>
      <h2>How we use it</h2>
      <p>We use your details only to reply to you and to consider any partnership you propose. We do not sell or share them for marketing.</p>
      <h2>How long we keep it</h2>
      <p>We keep correspondence for as long as it is needed for the purpose you wrote to us about, and then delete it.</p>
      <h2>Your choices</h2>
      <p>
        You can ask us to see, correct or delete the information we hold about you by writing to
        <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
      <h2>Who we are</h2>
      <p>{site.legalName}, {site.address.join(', ')}.</p>
    </div>
  </section>
</Base>

<style>
  .body {
    padding: clamp(24px, 4vw, 48px);
    background: var(--white);
    border-radius: var(--radius);
  }
  .body h2 {
    font-size: var(--step-2);
    margin-top: 12px;
  }
  .body a {
    color: var(--navy);
    font-weight: 600;
  }
</style>
