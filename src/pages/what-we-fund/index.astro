---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { areas, areaOrder, partnersIn, stats } from '../../lib/site';
import { img } from '../../lib/images';
---

<Base
  title="What we fund"
  description="MFE funds healthcare, education and training, livelihood enhancement and nurturing excellence, through NGO partners working with rural and tribal communities in India."
  image={img('site/education.webp')}
>
  <PageHero
    eyebrow="What we fund"
    title="Four areas where patient funding changes lives."
    lead={`We work through ${stats.partners} partner organisations in ${stats.states} states and across India. Each area has its own focus, and the same five tests apply to all of them.`}
    crumbs={[{ href: '/what-we-fund/', label: 'What we fund' }]}
  />

  <section class="section--tight">
    <div class="wrap list">
      {
        areaOrder.map((slug, i) => {
          const a = areas[slug];
          const ps = partnersIn(slug);
          return (
            <article class:list={['row reveal', { flip: i % 2 === 1 }]}>
              <a href={`/what-we-fund/${slug}/`} class="pic" tabindex="-1" aria-hidden="true">
                <Image src={img(a.image)} alt="" widths={[480, 800, 1100]} sizes="(max-width: 900px) 100vw, 55vw" />
              </a>
              <div class="copy">
                <span class="eyebrow">{String(i + 1).padStart(2, '0')} · {ps.length} partners</span>
                <h2>
                  <a href={`/what-we-fund/${slug}/`}>{a.title}</a>
                </h2>
                <p class="tag">{a.tagline}</p>
                <p class="intro">{a.intro}</p>
                <ul class="names">
                  {ps.slice(0, 6).map((p) => <li class="chip">{p.name}</li>)}
                  {ps.length > 6 && <li class="chip more">+{ps.length - 6} more</li>}
                </ul>
                <a class="btn" href={`/what-we-fund/${slug}/`}>
                  Explore {a.short.toLowerCase()} <Arrow />
                </a>
              </div>
            </article>
          );
        })
      }
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .list {
    display: grid;
    gap: clamp(48px, 8vw, 112px);
  }
  .row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  .row.flip .pic {
    order: 2;
  }
  .pic {
    display: block;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .pic :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(.2,.7,.2,1);
  }
  .row:hover .pic :global(img) {
    transform: scale(1.04);
  }
  .copy {
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  h2 {
    font-size: var(--step-4);
  }
  h2 a {
    text-decoration: none;
  }
  .tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--navy);
    line-height: 1.2;
  }
  .intro {
    color: var(--muted);
  }
  .names {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .names .chip {
    white-space: normal;
  }
  .more {
    background: var(--navy);
    color: var(--white);
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row.flip .pic {
      order: 0;
    }
  }
</style>
