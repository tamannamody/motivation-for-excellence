---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, areas, areaOrder, values, stats, partners, partnersIn, people, bySlug } from '../lib/site';
import { img } from '../lib/images';

const stories = [
  {
    slug: 'karuna-trust',
    kicker: 'Healthcare · Assam',
    title: 'A floating clinic on the Brahmaputra',
    body: 'A boat clinic brings dental, eye and ultrasound care to tribal and riverine villages in Biswanath and Lakhimpur, with a goal of cutting infant mortality by at least 10% in a year.',
  },
  {
    slug: 'dr-apj-kalam-library-mgims',
    kicker: 'Healthcare · Wardha',
    title: 'A heritage library, rebuilt for the next generation of rural doctors',
    body: 'The Dr APJ Kalam Library at MGIMS Sewagram grew from 2,700 to 16,000 square feet, keeping the heritage structure intact.',
  },
  {
    slug: 'bridges-of-sports',
    image: 'partners/bridges-of-sports/1.webp',
    kicker: 'Nurturing Excellence · Karnataka',
    title: 'India’s fastest sprinters, from the back of beyond',
    body: 'Bridges of Sports finds and trains young sprinters from Siddi and other tribal communities in Uttara Kannada, with its sights on the 2028 Olympics.',
  },
];
const featured = stories.map((s) => ({ ...s, p: bySlug(s.slug)! }));
const marquee = partners.map((p) => p.name);
---

<Base title={site.name} description={site.description} headerTone="dark">
  <!-- Hero -->
  <section class="hero on-dark">
    <Image
      src={img('site/hero-circle.webp')}
      alt="Villagers standing in a wide circle at a community meeting in the hills"
      class="hero-img"
      widths={[640, 1024, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
    />
    <video class="hero-img hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="/media/hero.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <span class="eyebrow">Motivation for Excellence · since {stats.since}</span>
      <h1>Backing excellence, <em>however humble the work.</em></h1>
      <p class="lead">
        We partner with NGOs bringing healthcare, education and livelihoods to India’s rural and tribal communities, and help
        their best ideas grow.
      </p>
      <div class="hero-cta">
        <a class="btn btn--teal btn--lg btn--pulse" href="/partners/">Meet our {stats.partners} partners <Arrow /></a>
        <a class="btn btn--ghost-light btn--lg" href="/about/">Our story</a>
      </div>
    </div>
  </section>

  <!-- Numbers -->
  <section class="stats-wrap">
    <div class="wrap">
      <dl class="stats">
        <div><dt>Partner organisations</dt><dd>{stats.partners}</dd></div>
        <div><dt>Areas of work</dt><dd>{stats.areas}</dd></div>
        <div><dt>States, plus pan-India work</dt><dd>{stats.states}</dd></div>
        <div><dt>Partnering since</dt><dd>{stats.since}</dd></div>
      </dl>
    </div>
  </section>

  <!-- Mission -->
  <section class="section bgfx bgfx--teal" style="--dots-at: 8% 85%">
    <div class="wrap mission">
      <div class="reveal mission-card">
        <span class="eyebrow">Our mission</span>
        <p class="statement">
          To nurture <mark>values-based excellence</mark> and a passion for helping catalyse improvements in society.
        </p>
      </div>
      <div class="mission-side reveal">
        <p class="lead">
          We focus on solutions that are innovative, yet pragmatic and effective. Most of our work happens through partners:
          NGOs who know their communities, and whom we support with grants, guidance and connections.
        </p>
        <figure class="founder">
          <Image class="founder-photo" src={img(people.founder.image)} alt={`Portrait of ${people.founder.name}`} width={96} height={128} />
          <strong>{people.founder.name}</strong>
          <span class="founder-meta">{people.founder.years} · {people.founder.role}</span>
          <p class="founder-tribute">A quiet, self-made man who rose from little and left his life's work to society.</p>
          <p class="founder-vision">He believed excellence lives in the humblest work done extraordinarily well, and built MFE to find it and back it.</p>
          <a class="link-arrow" href="/about/">Read our story <Arrow size={16} /></a>
        </figure>
      </div>
    </div>
  </section>

  <!-- Areas -->
  <section class="section areas-sec bgfx bgfx--navy bgfx--ring">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">What we fund</span>
        <h2>Four areas, one standard.</h2>
        <p class="lead">We go deep in a few areas where steady, patient funding changes what is possible for rural and tribal families.</p>
      </div>
      <div class="bento">
        {
          areaOrder.map((slug, i) => {
            const a = areas[slug];
            return (
              <a href={`/what-we-fund/${slug}/`} class={`tile tile-${i + 1} reveal`}>
                <Image src={img(a.image)} alt="" widths={[480, 800, 1100]} sizes="(max-width: 760px) 100vw, 50vw" loading="lazy" />
                <div class="tile-shade" aria-hidden="true" />
                <div class="tile-body">
                  <span class="count">{partnersIn(slug).length} partners</span>
                  <h3>{a.title}</h3>
                  <p>{a.tagline}</p>
                  <span class="go" aria-hidden="true"><Arrow size={20} /></span>
                </div>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="section on-dark values-sec">
    <div class="circle-track">
      <div class="circle-pin">
        <div class="circle-stage">
          <svg class="circle-svg" viewBox="0 0 600 600" aria-hidden="true">
            <circle class="circle-track-ring" cx="300" cy="300" r="240" />
            <circle class="circle-draw" cx="300" cy="300" r="240" />
          </svg>
          <div class="circle-center">
            <span class="eyebrow">How we choose partners</span>
            <h2>Five things<br />we look for.</h2>
          </div>
          <ul class="circle-points">
            {
              values.map((v, i) => (
                <li class="cpoint">
                  <span class="cdot" />
                  <div class="clabel">
                    <strong>{v.title}</strong>
                    <span class="cbody">{v.body}</span>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Stories -->
  <section class="section bgfx bgfx--teal bgfx--contour">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">From the field</span>
        <h2>What partnership looks like.</h2>
      </div>
      <div class="stories">
        {
          featured.map((s, i) => (
            <a href={`/partners/${s.slug}/`} class="story reveal">
              <div class="story-media">
                <Image src={img((s as any).image || s.p.images[0])} alt="" widths={[480, 800, 1200]} sizes="(max-width: 960px) 100vw, 33vw" loading="lazy" />
              </div>
              <div class="story-body">
                <span class="kicker">{s.kicker}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <span class="link-arrow">{s.p.name} <Arrow size={16} /></span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Partner marquee -->
  <section class="section--tight marquee-sec" aria-labelledby="partners-h">
    <div class="wrap marquee-head">
      <h2 id="partners-h">In good company</h2>
      <a class="link-arrow" href="/partners/">See all {stats.partners} partners <Arrow size={16} /></a>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="track">
        {marquee.map((n) => <span>{n}</span>)}
        {marquee.map((n) => <span class="dup">{n}</span>)}
      </div>
    </div>
    <p class="sr-only">Partners include {marquee.join(', ')}.</p>
  </section>

  <!-- Quote -->
  <section class="section quote-sec">
    <figure class="narrow quote reveal">
      <div class="q-mark stripes" aria-hidden="true"></div>
      <blockquote>
        We must learn to honor excellence in every socially accepted human activity, however humble the activity, and to
        scorn shoddiness, however exalted the activity.
      </blockquote>
      <figcaption>John W. Gardner · author and leader</figcaption>
    </figure>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(100svh, 920px);
    display: grid;
    align-content: end;
    padding-top: calc(var(--header-h) + 40px);
    padding-bottom: 28px;
    overflow: hidden;
    background: var(--navy-950);
  }
  .hero :global(.hero-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(8 21 58 / 0.55) 0%, rgb(8 21 58 / 0.15) 30%, rgb(8 21 58 / 0.7) 62%, rgb(8 21 58 / 0.96) 100%),
      linear-gradient(90deg, rgb(8 21 58 / 0.6) 0%, transparent 70%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    gap: 24px;
    padding-bottom: clamp(32px, 6vw, 72px);
  }
  .hero h1 {
    font-size: clamp(2.8rem, 1.6rem + 6vw, 7.2rem);
    color: var(--white);
    max-width: 14ch;
    line-height: 0.98;
    font-weight: 400;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--teal-300);
    font-weight: 350;
  }
  .hero .lead {
    max-width: 56ch;
    color: #dde5f7;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .caption {
    position: relative;
    font-size: 0.78rem;
    color: #9fb0db;
    letter-spacing: 0.02em;
  }

  /* Stats */
  .stats-wrap {
    background: var(--navy-950);
    padding-top: clamp(24px, 4vw, 48px);
    padding-bottom: 0;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin: 0;
    background: var(--white);
    border-radius: var(--radius) var(--radius) 0 0;
    overflow: hidden;
  }
  .stats div {
    padding: clamp(22px, 3vw, 36px);
    display: flex;
    flex-direction: column-reverse;
    gap: 6px;
    border-right: 1px solid var(--line);
  }
  .stats div:last-child {
    border-right: 0;
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--navy);
    font-variant-numeric: lining-nums;
  }
  .stats dt {
    color: var(--muted);
    font-size: var(--step--1);
  }

  /* Mission */
  .mission {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .mission-card {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: clamp(28px, 4vw, 52px);
    background: #fbfaf6;
    border: 1px solid var(--line);
    isolation: isolate;
  }
  .mission-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url("/media/mission-kids.jpg") center / cover no-repeat;
    opacity: 0.2;
  }
  .mission-card .statement { margin-top: 0; }
  @media (max-width: 760px) {
    .mission-card { aspect-ratio: auto; min-height: 460px; }
  }
  .statement {
    margin-top: 20px;
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.1;
    letter-spacing: -0.02em;
    font-weight: 400;
  }
  .statement mark {
    background: linear-gradient(transparent 62%, rgb(66 192 182 / 0.45) 62%);
    color: inherit;
  }
  .mission-side {
    display: grid;
    gap: 32px;
    padding-top: 12px;
  }
  .mission-side .lead {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: #2a4db0;
  }
  .founder {
    position: relative;
    aspect-ratio: 1 / 1;
    margin: 0;
    padding: clamp(26px, 3vw, 40px);
    background: var(--navy);
    color: #e9eefb;
    border-radius: var(--radius);
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
  }
  .founder :global(.founder-photo) {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 15%;
    border: 2px solid rgb(255 255 255 / 0.18);
  }
  .founder strong {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--white);
    font-weight: 500;
    line-height: 1.05;
  }
  .founder-meta {
    color: var(--teal-300);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    margin-top: -4px;
  }
  .founder-tribute { margin: 4px 0 0; color: #e9eefb; }
  .founder-vision { margin: 0; color: #b9c4dd; font-size: var(--step--1); }
  .founder .link-arrow {
    margin-top: auto;
    color: var(--teal-300);
  }
  @media (max-width: 760px) {
    .founder { aspect-ratio: auto; }
  }

  /* Areas bento */
  .areas-sec {
    padding-top: 0;
  }
  .bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .tile {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
    color: var(--white);
    text-decoration: none;
    background: var(--navy);
    aspect-ratio: 3 / 4;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1), box-shadow 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid #2d52c8;
    pointer-events: none;
    transition: border-color 0.5s ease;
  }
  .tile:hover {
    transform: translateY(-6px);
    box-shadow: 0 26px 52px -26px rgb(8 21 58 / 0.7);
  }
  .tile:hover::after { border-color: #5a7ceb; }
  .tile-1, .tile-2, .tile-3, .tile-4 { grid-column: auto; grid-row: auto; }
  @media (max-width: 1000px) {
    .bento { grid-template-columns: repeat(2, 1fr); }
    .tile { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .tile { aspect-ratio: 16 / 10; }
  }
  .tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s cubic-bezier(.2,.7,.2,1), filter 0.6s ease;
  }
  .tile:hover :global(img) {
    transform: scale(1.09);
    filter: saturate(1.08) brightness(1.04);
  }
  .tile-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgb(8 21 58 / 0.88) 100%);
    transition: background 0.5s ease;
  }
  .tile:hover .tile-shade {
    background: linear-gradient(180deg, rgb(8 21 58 / 0.1) 0%, rgb(8 21 58 / 0.5) 52%, rgb(8 21 58 / 0.95) 100%);
  }
  .tile-body {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(18px, 2vw, 24px);
    padding-right: 72px;
    display: grid;
    gap: 6px;
    transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .tile:hover .tile-body { transform: translateY(-5px); }
  .tile h3 {
    font-size: var(--step-2);
    line-height: 1.15;
  }
  .tile p {
    color: #d9e2f6;
    font-size: 0.95rem;
    line-height: 1.45;
    max-width: 40ch;
    opacity: 0.82;
    transition: opacity 0.5s ease;
  }
  .tile:hover p { opacity: 1; }
  .count {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--teal-300);
  }
  .go {
    position: absolute;
    right: clamp(18px, 2vw, 24px);
    bottom: clamp(18px, 2vw, 24px);
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--teal);
    color: var(--navy-950);
    transition: transform 0.4s cubic-bezier(.2,.7,.2,1), box-shadow 0.4s ease;
  }
  .go :global(svg) { transition: transform 0.4s cubic-bezier(.2,.7,.2,1); }
  .tile:hover .go {
    transform: scale(1.12);
    box-shadow: 0 10px 26px -6px rgb(73 195 191 / 0.55);
  }
  .tile:hover .go :global(svg) { transform: translateX(3px); }

  /* Values — pinned circle */
  .values-sec { padding: 0; background: var(--navy-900); }
  .circle-track { position: relative; height: 300vh; }
  .circle-pin {
    position: sticky; top: 0; height: 100vh; min-height: 620px;
    display: grid; place-items: center; overflow: hidden;
  }
  .circle-stage { position: relative; width: min(70vmin, 530px); aspect-ratio: 1; }
  .circle-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .circle-track-ring { fill: none; stroke: rgb(255 255 255 / 0.06); stroke-width: 2; }
  .circle-draw {
    fill: none; stroke: var(--teal); stroke-width: 3; stroke-linecap: round;
    transform: rotate(-90deg); transform-box: fill-box; transform-origin: center;
  }
  .circle-center {
    position: absolute; inset: 0; display: grid; place-content: center;
    text-align: center; gap: 12px; padding: 0 23%; pointer-events: none;
  }
  .circle-center .eyebrow { justify-self: center; }
  .circle-center h2 { font-size: clamp(1.5rem, 0.9rem + 2vw, 2.4rem); color: var(--white); line-height: 1.05; }
  .circle-points { position: absolute; inset: 0; list-style: none; margin: 0; padding: 0; }
  .cpoint { position: absolute; transform: translate(-50%, -50%); opacity: 0; transition: opacity 0.45s ease; }
  .cpoint.on { opacity: 1; }
  .cdot { display: block; width: 14px; height: 14px; border-radius: 50%; background: var(--teal); box-shadow: 0 0 0 6px rgb(73 195 191 / 0.18); }
  .clabel { position: absolute; width: 196px; display: grid; gap: 2px; color: #cdd6ea; font-size: 0.86rem; line-height: 1.3; }
  .clabel strong { color: var(--white); font-family: var(--font-display); font-size: 1.15rem; font-weight: 500; }
  .clabel .cnum { color: var(--teal-300); font-size: 0.72rem; letter-spacing: 0.1em; font-weight: 700; }
  .clabel .cbody { color: #aeb9d6; }
  .cpoint[data-side="top"] .clabel { bottom: 44px; left: 50%; transform: translateX(-50%); text-align: center; justify-items: center; }
  .cpoint[data-side="right"] .clabel { left: 44px; top: 50%; transform: translateY(-50%); text-align: left; }
  .cpoint[data-side="left"] .clabel { right: 44px; top: 50%; transform: translateY(-50%); text-align: right; justify-items: end; }
  @media (max-width: 760px) {
    .circle-track { height: 260vh; }
    .circle-stage { width: 90vmin; }
    .clabel { width: 118px; font-size: 0.74rem; }
    .clabel strong { font-size: 0.96rem; }
  }

  /* Stories */
  .stories {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .story {
    display: grid;
    grid-template-rows: auto 1fr;
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: #fff;
    transition: box-shadow 0.4s ease, transform 0.4s ease;
  }
  .story:nth-child(1) { background: #1b2a45; }
  .story:nth-child(2) { background: #0e5753; }
  .story:nth-child(3) { background: #8a4836; }
  .story:hover {
    box-shadow: 0 26px 52px -26px rgb(8 21 58 / 0.55);
    transform: translateY(-5px);
  }
  .story-media {
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
  }
  .story-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  }
  .story:hover .story-media :global(img) {
    transform: scale(1.04);
  }
  .story-body {
    display: grid;
    gap: 12px;
    align-content: start;
    padding: clamp(20px, 3vw, 32px);
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.68);
  }
  .story h3 {
    font-size: var(--step-2);
    color: #fff;
  }
  .story .link-arrow {
    margin-top: auto;
    color: #fff;
  }
  .story p {
    color: rgb(255 255 255 / 0.8);
  }

  /* Marquee */
  .marquee-sec {
    background: linear-gradient(90deg, var(--teal-50), var(--white) 30%, var(--white) 70%, var(--teal-50));
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .marquee-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
  }
  .marquee-head h2 {
    font-size: var(--step-2);
  }
  .marquee {
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .track {
    display: flex;
    gap: 48px;
    width: max-content;
    animation: scroll 120s linear infinite;
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }
  .track span {
    font-family: var(--font-display);
    font-size: var(--step-2);
    color: var(--navy);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 48px;
  }
  .track span::after {
    content: '';
    width: 10px;
    height: 10px;
    background: var(--teal);
    transform: rotate(45deg);
  }
  @keyframes scroll {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      padding-inline: var(--gutter);
      gap: 12px 32px;
    }
