<script>
  const stats = document.querySelector('.stats');
  const nums = stats ? stats.querySelectorAll('dd') : [];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (stats && nums.length && !reduce) {
    const targets = [];
    nums.forEach((el) => {
      const finalText = (el.textContent || '').trim();
      const n = parseInt(finalText.replace(/[^0-9]/g, ''), 10);
      targets.push({ el, finalText, n: Number.isFinite(n) ? n : null });
      if (Number.isFinite(n)) el.textContent = '0';
    });
    const ease = (t) => 1 - Math.pow(1 - t, 3);
    const run = () => {
      const dur = 1300, start = performance.now();
      const tick = (now) => {
        const p = Math.min((now - start) / dur, 1);
        targets.forEach((t) => { if (t.n !== null) t.el.textContent = String(Math.round(ease(p) * t.n)); });
        if (p < 1) requestAnimationFrame(tick);
        else targets.forEach((t) => { t.el.textContent = t.finalText; });
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries, obs) => {
      if (entries.some((e) => e.isIntersecting)) { run(); obs.disconnect(); }
    }, { threshold: 0.4 });
    io.observe(stats);
  }
</script>

<script>
  (function () {
    const track = document.querySelector('.circle-track');
    if (!track) return;
    const ring = track.querySelector('.circle-draw');
    const points = Array.from(track.querySelectorAll('.cpoint'));
    const R = 240, C = 2 * Math.PI * R, N = points.length || 1;
    ring.style.strokeDasharray = String(C);
    ring.style.strokeDashoffset = String(C);
    points.forEach((p, i) => {
      const ang = (i / N) * Math.PI * 2;
      const x = 50 + 40 * Math.sin(ang);
      const y = 50 - 40 * Math.cos(ang);
      p.style.left = x + '%';
      p.style.top = y + '%';
      p.dataset.side = Math.abs(x - 50) < 6 ? 'top' : (x > 50 ? 'right' : 'left');
    });
    const DRAW_END = 0.86;
    let ticking = false;
    const update = () => {
      ticking = false;
      const rect = track.getBoundingClientRect();
      const total = track.offsetHeight - window.innerHeight;
      let progress = total > 0 ? (-rect.top) / total : 0;
      progress = Math.max(0, Math.min(1, progress));
      const cp = Math.min(progress / DRAW_END, 1);
      ring.style.strokeDashoffset = String(C * (1 - cp));
      points.forEach((p, i) => { p.classList.toggle('on', cp >= (i + 0.0001) / N); });
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>