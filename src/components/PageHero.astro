---
import { link } from '../lib/url';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { eyebrow: string; title: string; lead?: string; image?: ImageMetadata; imageAlt?: string; caption?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, image, imageAlt = '', caption, crumbs = [] } = Astro.props;
---

<section class:list={['hero', { 'has-image bgfx bgfx--teal': !!image }]}>
  <div class="wrap inner">
    <div class="text">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href={link('/')}>Home</a></li>
            {crumbs.map((c) => <li><a href={link(c.href)}>{c.label}</a></li>)}
          </ol>
        </nav>
      )}
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="pic">
        <span class="sun" aria-hidden="true" />
        <span class="orbit" aria-hidden="true" />
        <div class="frame">
          <Image src={image} alt={imageAlt} widths={[480, 720, 960, 1200]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" fetchpriority="high" />
        </div>
        {caption && (
          <span class="cap">
            <span class="cap-dot" aria-hidden="true" />
            {caption}
          </span>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 96px);
  }
  .inner {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .has-image .inner {
    grid-template-columns: 1.15fr 1fr;
  }
  .text {
    display: grid;
    gap: 22px;
    max-width: 820px;
  }
  h1 {
    font-size: var(--step-5);
  }
  /* Photo: arch frame, teal sun and orbit ring behind, floating caption */
  .pic {
    position: relative;
    isolation: isolate;
    padding: 20px 20px 28px;
  }
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: 280px 280px var(--radius) var(--radius);
    border: 6px solid var(--white);
    box-shadow: 0 34px 60px -30px rgb(8 21 58 / 0.55);
  }
  .frame :global(img) {
    width: 100%;
    aspect-ratio: 4 / 4.2;
    object-fit: cover;
    object-position: 50% 40%;
    transform: scale(1.02);
    transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
  }
  .pic:hover .frame :global(img) {
    transform: scale(1.07);
  }
  .sun {
    position: absolute;
    z-index: -1;
    right: -6%;
    top: -4%;
    width: 62%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #7fe0d7, var(--teal) 70%);
    opacity: 0.9;
  }
  .orbit {
    position: absolute;
    z-index: -1;
    left: -8%;
    bottom: -6%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 2px solid rgb(28 60 140 / 0.35);
    outline: 1px dashed rgb(28 60 140 / 0.25);
    outline-offset: 18px;
  }
  .cap {
    position: absolute;
    left: 0;
    bottom: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 85%;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--navy);
    color: var(--white);
    font-size: 0.9rem;
    font-weight: 550;
    line-height: 1.3;
    box-shadow: 0 18px 36px -16px rgb(8 21 58 / 0.7);
  }
  .cap-dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 4px rgb(66 192 182 / 0.3);
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--line);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .has-image .inner {
      grid-template-columns: 1fr;
    }
    .pic {
      max-width: 520px;
    }
    .frame {
      border-radius: 200px 200px var(--radius) var(--radius);
    }
  }
</style>
