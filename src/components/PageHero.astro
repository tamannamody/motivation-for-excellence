---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { eyebrow: string; title: string; lead?: string; image?: ImageMetadata; imageAlt?: string; crumbs?: { href: string; label: string }[] }
const { eyebrow, title, lead, image, imageAlt = '', crumbs = [] } = Astro.props;
---

<section class:list={['hero', { 'has-image': !!image }]}>
  <div class="wrap inner">
    <div class="text">
      {crumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol>
            <li><a href="/">Home</a></li>
            {crumbs.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
          </ol>
        </nav>
      )}
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {image && (
      <div class="pic">
        <Image src={image} alt={imageAlt} widths={[480, 720, 960]} sizes="(max-width: 900px) 100vw, 520px" loading="eager" fetchpriority="high" />
        <div class="deco stripes" aria-hidden="true" />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 96px) clamp(48px, 7vw, 96px);
  }
  .inner {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .has-image .inner {
    grid-template-columns: 1.15fr 1fr;
  }
  .text {
    display: grid;
    gap: 22px;
    max-width: 820px;
  }
  h1 {
    font-size: var(--step-5);
  }
  .pic {
    position: relative;
  }
  .pic :global(img) {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .deco {
    position: absolute;
    right: -18px;
    bottom: -18px;
    width: 46%;
    height: 46%;
    border-radius: var(--radius);
    opacity: 0.55;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '/';
    margin-right: 8px;
    color: var(--line);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  @media (max-width: 900px) {
    .has-image .inner {
      grid-template-columns: 1fr;
    }
    .deco {
      right: -8px;
      bottom: -8px;
    }
  }
</style>
